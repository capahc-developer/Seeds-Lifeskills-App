rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /adultProfiles/{uid} {
      allow read, write: if signedInAs(uid);
    }

    match /studentProfiles/{uid} {
      allow read, write: if signedInAs(uid);
    }

    match /users/{uid}/practiceLog/{entryId} {
      allow read, write: if signedInAs(uid);
    }

    match /users/{uid}/practicePlans/{planId} {
      allow read, create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['title', 'goal', 'steps', 'durationMinutes', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.goal is string
        && request.resource.data.steps is list
        && request.resource.data.steps.size() > 0
        && request.resource.data.steps.size() <= 6
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 1
        && request.resource.data.durationMinutes <= 60;
      allow delete: if signedInAs(uid);
    }

    match /skills/{skillId} {
      allow read: if request.auth != null;
    }
  }
}
